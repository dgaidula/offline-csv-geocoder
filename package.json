{
  "name": "csv-geocoder",
  "version": "1.0.0",
  "description": "Offline, zero-dependency forward geocoder that appends Lat/Lon columns to CSVs by City/State/Country with US ZIP and Canadian postal-code precision. No API key.",
  "keywords": [
    "geocode",
    "geocoding",
    "geocoder",
    "offline",
    "csv",
    "latitude",
    "longitude",
    "zip",
    "postal-code",
    "geonames",
    "batch",
    "cli"
  ],
  "bin": {
    "csv-geocoder": "index.js"
  },
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "aliases.example.json",
    "examples/sample.csv",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.js",
    "smoke": "node index.js examples/sample.csv -o /tmp/csv-geocoder-smoke.csv"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "author": "Dan Gaidula <dan@iceboxind.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgaidula/csv-geocoder.git"
  },
  "homepage": "https://github.com/dgaidula/csv-geocoder#readme",
  "bugs": {
    "url": "https://github.com/dgaidula/csv-geocoder/issues"
  }
}
